<Project Sdk="Microsoft.NET.Sdk">
  <!-- The accounting grid as a browser module: it draws its whole interface onto one <canvas> through the functions of runtime/gfx.js (fsharp-wasm-runtime), which also forwards
       pointer, key and size events to the exports of this module.  Compiled to WasmGC by the fsharp-wasm compiler:  bash build/build.sh  ->  dist/AccountingGrid.wasm
       Only this project's last file becomes the module's exports; the dependencies stay in their own projects. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Accounting.Browser</RootNamespace>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AccountingGrid.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Accounting/Accounting.fsproj" />
    <ProjectReference Include="../../lib/graphics/src/FSharp.Graphics.Canvas/FSharp.Graphics.Canvas.fsproj" />
  </ItemGroup>
</Project>
