<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tests of the accounting grid, written with Wasmecto: the ledger, the model that folds, turns and opens tabs, and the scene it draws.
       Under .NET: `bash build/test.sh`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900;NETSDK1188</NoWarn>
    <FSHARP_WASM_CORE_DIR Condition="'$(FSHARP_WASM_CORE_DIR)' == ''">$(MSBuildThisFileDirectory)../../lib/fsharp-wasm-core</FSHARP_WASM_CORE_DIR>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Accounting/Accounting.fsproj" />
    <ProjectReference Include="../../lib/wasmecto/src/Wasmecto.fsproj" />
  </ItemGroup>
</Project>
